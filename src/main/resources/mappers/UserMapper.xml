<?xml version="1.0" encoding="utf-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">



<mapper namespace="com.sourjelly.memo.user.repository.UserRepository">
    <insert id="insertUser" parameterType="map">
        INSERT INTO
            `user`
        (
            `login_id`
            , `password`
            , `name`
            , `email`
        )
        VALUE
        (
            #{loginId}
            , #{password}
            , #{name}
            , #{email}
        )
    </insert>

    <select id="selectUser" parameterType="map"
            resultType="com.sourjelly.memo.user.domain.User">
        SELECT
           `login_id`
            , `password`
            , `name`
            , `email`
            , `created_at`
            , `updated_at`
        FROM
            `user`
        WHERE
            `login_id` = #{loginId} AND `password`= #{password}
    </select>

</mapper>